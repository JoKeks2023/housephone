#!/bin/sh
# Kurzbefehl für die Bridge im Docker-Container, im Ordner der docker-compose.yml ausführen:
#   ./housephone tui | pair -name "iPhone" | devices list | identity | version
set -e
cd "$(dirname "$0")"
if [ -t 0 ] && [ -t 1 ]; then
  exec docker compose exec housephone-bridge housephone-bridge "$@"
else
  exec docker compose exec -T housephone-bridge housephone-bridge "$@"
fi
