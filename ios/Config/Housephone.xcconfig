// Base settings for the whole project (Debug and Release).
//
// Your own team and bundle IDs go into Local.xcconfig next to this file.
// It is not checked in; "Housephone einrichten.command" in the repo root
// writes it. Values there override the defaults below.

// Apple Developer team that signs the app.
DEVELOPMENT_TEAM = T9CA6D7T8N

// Bundle IDs: <prefix>.housephone (iPhone), <prefix>.housephone.watchkitapp
// (watch), <prefix>.housephone.widgets (widgets),
// <prefix>.housephone.watchkitapp.widgets (complications) and
// <prefix>.housephone.localpush (Local Push extension). The bridge's APNs
// topic must be <prefix>.housephone.voip.
HOUSEPHONE_BUNDLE_PREFIX = com.jorisconrad

// App Group shared by the iPhone app and its extensions (widgets,
// controls). The app derives the same ID from its bundle ID at runtime.
HOUSEPHONE_APP_GROUP = group.$(HOUSEPHONE_BUNDLE_PREFIX).housephone

// CarPlay (T-0017): Apple grants the entitlement
// com.apple.developer.carplay-communication only on request. Until then the
// app signs without it. Once granted, set HOUSEPHONE_CARPLAY_SUFFIX =
// -CarPlay in Local.xcconfig (or run the setup script with --carplay); the
// app then signs with Housephone/Housephone-CarPlay.entitlements.
HOUSEPHONE_CARPLAY_SUFFIX =

#include? "Local.xcconfig"
