    },
    "Der Code ist abgelaufen. Starte die Kopplung auf dem iPhone neu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code has expired. Start pairing again on your iPhone."
          }
        }
      }
    },
    "Der Code ist ungültig oder abgelaufen. Starte die Kopplung auf dem iPhone neu.": {
      "localizations": {
        "en": {
