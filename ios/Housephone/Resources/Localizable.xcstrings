{
  "sourceLanguage" : "de",
  "strings" : {
    "„%@“ (%@) gibt es schon. Beim Weiterverwenden bekommt es ein neues Kennwort." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” (%2$@) already exists. Keeping it gives it a new password."
          }
        }
      }
    },
    "„%@“ wurde %@ mit deiner Bridge gekoppelt. Warst du das nicht? Entferne das Gerät auf dem Server." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” was paired with your bridge %2$@. Not you? Remove the device on the server."
          }
        }
      }
    },
    "„Automatisch“ nimmt die erste Nummer der FRITZ!Box." : {
