      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge unreachable"
          }
        }
      }
    },
    "Danach klingelt dieses iPhone nicht mehr. Du kannst es jederzeit neu koppeln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone will stop ringing. You can pair it again at any time."
          }
        }
      }
    },
    "Das ist kein Housephone-Code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's not a Housephone code."
          }
        }
      }
    },
    "Das ist kein Housephone-Kopplungslink.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's not a Housephone pairing link."
          }
        }
      }
    },
    "Dein Festnetz auf dem iPhone – über deine FRITZ!Box, zu Hause und unterwegs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your landline on your iPhone – through your FRITZ!Box, at home and on the go."
          }
        }
      }
    },
    "Deine Kontakte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your contacts"
          }
        }
      }
    },
    "Den QR-Code zeigt dein Server mit `housephone-bridge pair` an.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server shows the QR code with `housephone-bridge pair`."
          }
        }
      }
    },
    "Der Anruf konnte nicht gestartet werden: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The call couldn't start: %@"
          }
        }
      }
    },
    "Der Code ist abgelaufen oder wurde schon benutzt. Erzeuge auf dem Server mit „housephone-bridge pair“ einen neuen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code has expired or was already used. Create a new one on the server with “housephone-bridge pair”."
          }
        }
      }
    },
    "Der Kopplungscode im Link ist ungültig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing code in the link is invalid."
          }
        }
      }
    },
    "Der Link enthält keine gültige Bridge-Adresse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link doesn't contain a valid bridge address."
          }
        }
      }
    },
    "Die bisherige Kopplung wird ersetzt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the current pairing."
          }
        }
      }
    },
    "Die Bridge ist gerade nicht erreichbar. Prüfe die Internetverbindung und versuche es erneut.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge can't be reached right now. Check your internet connection and try again."
          }
        }
      }
    },
    "Die Bridge ist nicht erreichbar. Prüfe die Adresse und deine Internetverbindung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge can't be reached. Check the address and your internet connection."
          }
        }
      }
    },
    "Die Bridge läuft auf deinem Server und ist für die FRITZ!Box ein IP-Telefon.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge runs on your server and acts as an IP phone for the FRITZ!Box."
          }
        }
      }
    },
    "Die Bridge meldet: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge says: %@"
          }
        }
      }
    },
    "Die Zugangsdaten konnten nicht sicher gespeichert werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The credentials couldn't be stored securely."
          }
        }
