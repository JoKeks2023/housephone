          "stringUnit" : {
            "state" : "translated",
            "value" : "Housephone isn’t registered with your FRITZ!Box. Check the credentials in Settings."
          }
        }
      }
    },
    "Housephone legt sich mit deiner FRITZ!Box-Anmeldung selbst als IP-Telefon an und lädt Telefonbuch und Anrufliste." : {
      "localizations" : {
