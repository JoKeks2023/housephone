    "Bridge kennt dieses iPhone nicht mehr – bitte neu koppeln": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge no longer knows this iPhone – please pair again"
          }
        }
      }
