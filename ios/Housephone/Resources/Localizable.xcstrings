      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone"
          }
        }
      }
    },
    "Du kannst den Zugriff in den Einstellungen erlauben. Wählen geht auch ohne – über das Tastenfeld.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can allow access in Settings. Dialing works without it, too – using the keypad."
