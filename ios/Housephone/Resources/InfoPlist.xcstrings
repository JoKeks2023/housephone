    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Kamera scannst du den QR-Code deiner Bridge, um dieses iPhone zu koppeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the camera to scan your bridge's QR code and pair this iPhone."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Housephone zeigt deine Kontakte an, damit du sie direkt anrufen kannst, und erkennt Anrufer an ihrem Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Housephone shows your contacts so you can call them directly, and shows callers by name."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Face ID bestätigst du Änderungen in der Verwaltung deiner Bridge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Face ID you confirm changes when managing your bridge."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu Hause spricht Housephone direkt mit deiner Bridge, damit Gespräche im WLAN bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At home, Housephone talks to your bridge directly so calls stay on your Wi-Fi."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Housephone braucht das Mikrofon, damit dich dein Gegenüber beim Telefonieren hört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Housephone needs the microphone so the other person can hear you during calls."
          }
        }
      }
    }
  },
  "version" : "1.0"
